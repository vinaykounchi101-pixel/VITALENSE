  "product_constraints": [
    "No AI slope.",
    "Do not let green dominate the interface.",
    "Do not present fabricated health readings as real user data.",
    "Distinguish measured, manually entered, imported, AI-generated and ML-forecast data.",
    "Show data source and freshness where relevant.",
    "Missing data is not zero and must not be labeled Normal by default.",
    "AI/ML outputs are informational and never diagnoses.",
    "Do not present future-phase features as completed Phase 1 functionality.",
    "Do not copy sample names or sample values from the reference as real user content.",
    "Create purpose-designed mobile screens rather than shrinking desktop layouts."
  ]
