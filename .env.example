# =============================================================================
# VitalSense Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development.
# 2. Never commit '.env' or any file containing real credentials or secrets to Git.
# 3. All default values below are documentation placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime Environment
# -----------------------------------------------------------------------------
# Options: development, test, staging, production
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL Database (Authoritative Central Store)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vitalsense_dev
POSTGRES_USER=vitalsense_user
POSTGRES_PASSWORD=replace_with_secure_dev_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
DATABASE_URL=postgresql+asyncpg://vitalsense_user:replace_with_secure_dev_password@localhost:5432/vitalsense_dev

# -----------------------------------------------------------------------------
# Backend Web-Facing API Service
# -----------------------------------------------------------------------------
WEB_API_HOST=0.0.0.0
WEB_API_PORT=8000
WEB_API_CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# Backend Mobile-Facing API Service
# -----------------------------------------------------------------------------
MOBILE_API_HOST=0.0.0.0
MOBILE_API_PORT=8001
MOBILE_API_CORS_ORIGINS=["*"]

# -----------------------------------------------------------------------------
# Identity & Authentication (OD-18 Planning)
# -----------------------------------------------------------------------------
# Secure random string (minimum 32 bytes in production)
AUTH_SECRET_KEY=replace_with_a_secure_random_32_character_secret_key
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Web Application (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_WEB_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Mobile Application (React Native / Expo)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_MOBILE_API_BASE_URL=http://localhost:8001
# Key alias for local database encryption (actual key generated in OS keychain)
MOBILE_LOCAL_DB_NAME=vitalsense_local.db

# -----------------------------------------------------------------------------
# Observability & Monitoring
# -----------------------------------------------------------------------------
ENABLE_STRUCTURED_LOGGING=true
CORRELATION_ID_HEADER=X-Correlation-ID

# -----------------------------------------------------------------------------
# Gated Future Phases (Do Not Enable Without Review)
# -----------------------------------------------------------------------------
# Phase 2 AI Integration (Gated - OD-05, OD-21)
FEATURE_FLAG_AI_ASSISTANT=false
AI_PROVIDER_API_KEY=placeholder_do_not_populate_in_phase_0

# Phase 3 ML Inference (Gated - OD-11)
FEATURE_FLAG_PREDICTIVE_ML=false

# Phase 4 Medical Records (Gated - OD-06, OD-12)
FEATURE_FLAG_MEDICAL_RECORDS=false

# Phase 5 Family Health (Gated - OD-13)
FEATURE_FLAG_FAMILY_MANAGEMENT=false
